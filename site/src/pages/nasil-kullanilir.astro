---
import Site from '../layouts/Site.astro'
import Phone from '../components/Phone.astro'

import { langOf, localize, translator } from '../lib/i18n'

const lang = langOf(Astro.url.pathname)
const t = translator(lang)
const free = t('Ücretsiz', 'Free')
const guide = [
  {
    id: 'baslangic',
    title: t('Hesabını aç', 'Create your account'),
    chip: free,
    img: 'ozet-light',
    dark: 'ozet-dark',
    intro: t('Harcama Atlası’nı web’de hemen, iOS ve Android’de yakında kullanabilirsin. Tek hesap, her cihazda aynı veriler.', 'Use Harcama Atlası on the web today, on iOS and Android soon. One account, the same data on every device.'),
    steps: [
      t('Uygulamayı aç ve e-posta adresinle kayıt ol ya da Google ile giriş yap.', 'Open the app and sign up with your email or sign in with Google.'),
      t('Finansal Harita testini çözdüysen aynı e-postayla gir; sonucun hesabına kendiliğinden bağlanır.', 'If you took the Financial Map test, sign in with the same email; your result is linked to your account automatically.'),
      t('Tema, bildirimler ve ay başlangıç günü Menü > Ayarlar’da.', 'Theme, language, notifications and the month start day are under Menu > Settings.'),
    ],
  },
  {
    id: 'harcama',
    title: t('Harcama ekle ya da içe aktar', 'Add or import spending'),
    chip: free,
    img: 'islemler-light',
    intro: t('Harcamalarını tek tek girebilir ya da kart ekstreni toplu olarak aktarabilirsin.', 'Enter expenses one by one or import your card statement in one go.'),
    steps: [
      t('Alttaki yeşil + düğmesine dokun.', 'Tap the green + button at the bottom.'),
      t('Tek harcama için tutarı, açıklamayı ve kategoriyi yazıp kaydet.', 'For a single expense, enter the amount, description and category, then save.'),
      t('Toplu ekleme için içe aktarmayı seç; PDF, Excel, CSV ya da ekran görüntüsü yükle.', 'To add many at once, choose import and upload a PDF, Excel, CSV or screenshot.'),
      t('Okunan satırları kontrol et, tekrar edenleri ve kategorileri düzelt, sonra kaydet.', 'Check the rows that were read, fix duplicates and categories, then save.'),
    ],
  },
  {
    id: 'ozet',
    title: t('Özet sayfasını oku', 'Read the Summary page'),
    chip: free,
    img: 'ozet-light',
    dark: 'ozet-dark',
    intro: t('Özet, bu dönemin haritasıdır: ne harcadın, bütçende ne kaldı, para en çok nereye gidiyor.', 'Summary is the map of this period: what you spent, what is left in your budget and where most of your money goes.'),
    steps: [
      t('Üstteki ay seçiciyle dönemler arasında geç.', 'Move between periods with the month picker at the top.'),
      t('Grup filtresiyle bireysel ya da ortak harcamalara bak.', 'Use the group filter to look at personal or shared spending.'),
      t('Bütçe kartında kalan tutarı, Kategoriler grafiğinde dağılımı gör.', 'See what is left on the budget card and the breakdown in the Categories chart.'),
    ],
  },
  {
    id: 'butce',
    title: t('Bütçeni kur', 'Set up your budget'),
    chip: 'Plus',
    img: 'butce-light',
    intro: t('Maaşını ve maaş gününü gir; dönem buna göre başlar ve bütçen gelirine göre hesaplanır.', 'Enter your salary and payday; periods start from that day and your budget is calculated from your income.'),
    steps: [
      t('Alt çubuktan Bütçe’ye geç ve maaşını ekle.', 'Go to Budget from the bottom bar and add your salary.'),
      t('Aylık bütçede Koç (otomatik) ya da Elle seçeneğini seç.', 'For the monthly budget, choose Coach (automatic) or Manual.'),
      t('Plus ile kategori limitleri, uyarılar ve ay sonu tahmini açılır.', 'Plus unlocks category limits, alerts and a month-end forecast.'),
    ],
  },
  {
    id: 'borclar',
    title: t('Borç ve ödemelerini planla', 'Plan your debts and payments'),
    chip: 'Plus',
    img: 'borclar-light',
    intro: t('Kart taksitleri, krediler ve düzenli ödemeler gelecek aylara yayılmış olarak görünür.', 'Card instalments, loans and recurring payments are laid out across the coming months.'),
    steps: [
      t('Menü’den Borçlar ve ödemeler’i aç.', 'Open Debts and payments from the Menu.'),
      t('Borç ekle ile türünü, kalan tutarı ve taksitleri gir.', 'Use Add debt to enter its type, remaining balance and instalments.'),
      t('Düzenli ödemeler sekmesinde kira, abonelik ve faturaları ekle; günü gelince hatırlatılır.', 'Add rent, subscriptions and bills under Recurring payments; you get a reminder on the day.'),
    ],
  },
  {
    id: 'yatirimlar',
    title: t('Yatırımlarını ekle', 'Add your investments'),
    chip: 'Plus',
    img: 'yatirim-ekle-light',
    dark: 'yatirim-ekle-dark',
    intro: t('Altın, döviz, mevduat, fon, BIST hisse, yabancı hisse/ETF, kripto ve emtia ekleyebilirsin. Fiyatı olanlar kendiliğinden güncellenir.', 'You can add gold, currencies, deposits, funds, BIST stocks, foreign stocks/ETFs, crypto and commodities. Anything with a market price updates on its own.'),
    steps: [
      t('Alt çubuktan Yatırım’a geç ve Yatırım ekle’ye dokun.', 'Go to Investments from the bottom bar and tap Add investment.'),
      t('Türünü seç. Adını yazınca sembol önerilir; altında hazır seçenekler de var.', 'Pick the type. As you type a name, the symbol is suggested; there are ready-made options too.'),
      t('Miktarı, birim alış fiyatını ve alış tarihini gir; toplam maliyet hemen hesaplanır.', 'Enter the quantity, unit purchase price and purchase date; the total cost is calculated right away.'),
      t('Kaydet. Sonraki alış ve satışları Alış / satış (telefonda İşlem) düğmesiyle eklersin.', 'Save. Add later purchases and sales with the Buy / sell button.'),
    ],
  },
  {
    id: 'kar-zarar',
    title: t('Güncel değeri ve kâr/zararı izle', 'Track current value and profit/loss'),
    chip: 'Plus',
    img: 'yatirim-liste-light',
    dark: 'yatirim-liste-dark',
    intro: t('Her yatırımın maliyetini, güncel değerini ve kâr/zararını tek listede görürsün. Fiyatları elle yenilemen gerekmez.', 'See the cost, current value and profit/loss of every investment in one list. You never need to refresh prices by hand.'),
    steps: [
      t('Fiyatlar uygulama açılınca ve açık kaldıkça 15 dakikada bir kendiliğinden güncellenir.', 'Prices update by themselves when you open the app and every 15 minutes while it stays open.'),
      t('Her satırda güncel değer ile kâr ya da zarar, tutar ve yüzde olarak yazar.', 'Each row shows the current value and the profit or loss as an amount and a percentage.'),
      t('Üstteki Özet kartında toplamı TL ya da $ USD olarak gör; Dağılım grafiği paranın nerede durduğunu gösterir.', 'See your total in dollars on the Summary card at the top; the Mix chart shows where your money sits.'),
    ],
  },
  {
    id: 'rota',
    title: t('Testi çöz, rotanı netleştir', 'Take the test, sharpen your route'),
    chip: t('Ücretsiz · Plus', 'Free · Plus'),
    img: 'test-sonuc',
    intro: t('Finansal Harita testi tahmini rotanı çıkarır. Plus ile gerçek kayıtların hesaba girer ve rota netleşir.', 'The Financial Map test charts your estimated route. With Plus, your real records are used and the route becomes exact.'),
    steps: [
      t('Menü’den Finansal Harita testini aç ve 10 soruyu yanıtla.', 'Open the Financial Map test from the Menu and answer the 10 questions.'),
      t('Sonuçta arketipini, konumunu ve özgürlük yılını gör.', 'See your archetype, your position and your freedom year in the result.'),
      t('Plus ile Finansal Yolculuğum’da Rotamı netleştir’e dokun; kesin tarih ve sıradaki durak çıkar.', 'With Plus, tap Sharpen my route in My Financial Journey to get an exact date and your next stop.'),
    ],
  },
  {
    id: 'koc',
    title: t('Koçla konuş', 'Talk to the coach'),
    chip: 'Plus+',
    img: 'koc-light',
    dark: 'koc-dark',
    intro: t('Koç senin rakamlarınla konuşur: borç kapatma sırası, ayrılacak birikim, sıradaki durak.', 'The coach talks with your numbers: which debt to pay first, how much to save, your next stop.'),
    steps: [
      t('Alt çubuktan Koç’a geç.', 'Go to Coach from the bottom bar.'),
      t('Kısa anketi doldur; koç seni tanısın. Gelirin, borçların ve yatırımların planına girer.', 'Fill in the short survey so the coach gets to know you. Your income, debts and investments go into its plan.'),
      t('Sorunu yaz ya da önerilen mesajlardan birini seç. Koç yatırım tavsiyesi vermez.', 'Type your question or pick a suggested message. The coach does not give investment advice.'),
    ],
  },
  {
    id: 'bilgi',
    title: t('Finansal bilgiyle öğren', 'Learn with financial know-how'),
    chip: 'Plus+',
    img: 'finansal-bilgi-light',
    dark: 'finansal-bilgi-dark',
    intro: t('Risk, likidite, enflasyon, çeşitlendirme gibi temel kavramlar kısa ve sade anlatılır; ekonomi gündemi de burada.', 'Key ideas like risk, liquidity, inflation and diversification are explained briefly and plainly; the economic agenda is here too.'),
    steps: [
      t('Menü’den Finansal bilgi’yi aç.', 'Open Financial know-how from the Menu.'),
      t('Temel kavramlar’da merak ettiğin başlığa dokun; açıklama hemen altında açılır.', 'Tap any topic under Key concepts; the explanation opens right below it.'),
      t('Kafana takılanı koça sor; senin rakamlarınla örnek verir. Genel bilgidir, yatırım tavsiyesi değildir.', 'Ask the coach about anything unclear; it answers with examples from your own numbers. General information, not investment advice.'),
    ],
  },
]
---

<Site
  title={t('Nasıl kullanılır · Harcama Atlası', 'Guide · Harcama Atlası')}
  description={t('Harcama Atlası’nı adım adım kullanmayı öğren: harcama ekleme, içe aktarma, bütçe, borçlar, yatırımlar, Finansal Harita testi ve koç.', 'Learn Harcama Atlası step by step: adding and importing spending, budget, debts, investments, the Financial Map test and the coach.')}
>
  <section class="wrap head">
    <p class="eyebrow reveal">{t('Rehber', 'Guide')}</p>
    {
      lang === 'en' ? (
        <h1 class="h-display reveal" style="--d:1"><span class="accent">How to use</span> Harcama Atlası</h1>
      ) : (
        <h1 class="h-display reveal" style="--d:1">Harcama Atlası <span class="accent">nasıl kullanılır?</span></h1>
      )
    }
    <p class="lead reveal" style="--d:2">{t('Hesabını açmaktan koçla konuşmaya kadar, her ekranı kısa adımlarla anlattık.', 'From creating your account to talking to the coach, every screen in short steps.')}</p>
  </section>

  <div class="wrap layout">
    <nav class="toc" aria-label={t('Rehber bölümleri', 'Guide sections')}>
      <ol>
        {
          guide.map((g, i) => (
            <li>
              <a href={`#${g.id}`} data-toc={g.id}>
                <span class="tn">{String(i + 1).padStart(2, '0')}</span>
                {g.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="sections">
      {
        guide.map((g, i) => (
          <section id={g.id} class="g reveal" aria-labelledby={`${g.id}-t`}>
            <div class="g-text">
              <span class:list={['chip', { 'chip-route': g.chip !== free }]}>{g.chip}</span>
              <h2 id={`${g.id}-t`}>
                <span class="gn">{String(i + 1).padStart(2, '0')}</span>
                {g.title}
              </h2>
              <p class="intro">{g.intro}</p>
              <ol class="g-steps">
                {g.steps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
            </div>
            <div class="g-phone">
              <Phone light={g.img} dark={g.dark} alt={t(`${g.title} ekranı`, `${g.title} screen`)} />
            </div>
          </section>
        ))
      }
      <div class="cta card reveal">
        <h2>{t('Hazır mısın?', 'Ready?')}</h2>
        <p>{t('İlk adım 2 dakikalık Finansal Harita testi.', 'The first step is the 2-minute Financial Map test.')}</p>
        <a class="btn btn-route" href={localize('/test', lang)}>{t('Testi çöz', 'Take the test')} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</Site>

<script>
  function tocInit() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')]
    if (!links.length) return
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (e.isIntersecting) links.forEach((l) => l.toggleAttribute('aria-current', l.dataset.toc === e.target.id))
        }),
      { rootMargin: '-40% 0px -55% 0px' },
    )
    document.querySelectorAll('.g').forEach((s) => io.observe(s))
  }
  document.addEventListener('astro:page-load', tocInit)
</script>

<style>
  .head {
    padding-block: 3rem 3.5rem;
  }
  .head h1 {
    margin-top: 1rem;
    max-width: 16ch;
  }
  .head .lead {
    margin-top: 1.25rem;
  }
  .layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 3.5rem;
    align-items: start;
  }
  .layout > * {
    min-width: 0;
  }
  .toc {
    position: sticky;
    top: 6rem;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1rem;
    border-left: 2px solid var(--line);
    display: grid;
    gap: 0.2rem;
  }
  .toc a {
    position: relative;
    display: flex;
    gap: 0.6rem;
    padding: 0.45rem 0;
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.94rem;
    transition: color 0.25s;
  }
  .toc a::before {
    content: '';
    position: absolute;
    left: calc(-1rem - 2px);
    top: 0.3rem;
    bottom: 0.3rem;
    width: 2px;
    background: var(--route);
    transform: scaleY(0);
    transition: transform 0.3s;
  }
  .toc a:hover,
  .toc a[aria-current] {
    color: var(--ink);
  }
  .toc a[aria-current] {
    font-weight: 600;
  }
  .toc a[aria-current]::before {
    transform: scaleY(1);
  }
  .tn {
    font-variant-numeric: tabular-nums;
    color: var(--route);
    font-weight: 700;
  }
  .sections {
    display: grid;
    gap: 1.5rem;
  }
  .g {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 2.5rem;
    align-items: center;
    padding: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--card);
  }
  .g h2 {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin: 0.8rem 0 0.5rem;
    font-size: clamp(1.45rem, 2.4vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }
  .gn {
    color: var(--route);
    font-size: 0.9em;
  }
  .intro {
    color: var(--ink-2);
    margin: 0 0 1.25rem;
  }
  .g-steps {
    list-style: none;
    counter-reset: s;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .g-steps li {
    counter-increment: s;
    position: relative;
    padding-left: 2.6rem;
    min-height: 1.8rem;
  }
  .g-steps li::before {
    content: counter(s);
    position: absolute;
    left: 0;
    top: -0.05rem;
    display: grid;
    place-items: center;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    background: var(--route-soft);
    color: var(--route);
    font: 800 0.85rem var(--display);
  }
  .g-steps li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0.88rem;
    top: 1.9rem;
    bottom: -0.7rem;
    border-left: 2px dotted var(--route);
    opacity: 0.4;
  }
  .g-phone {
    justify-self: center;
    width: 100%;
    max-width: 220px;
  }
  .cta {
    padding: 2.5rem;
    text-align: center;
    background: var(--band);
    color: var(--band-ink);
    border: 0;
  }
  .cta h2 {
    color: var(--band-ink);
    margin: 0;
    font-size: 1.8rem;
    font-weight: 800;
  }
  .cta p {
    opacity: 0.8;
    margin: 0.5rem 0 1.5rem;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .toc {
      position: static;
    }
    .toc ol {
      display: flex;
      overflow-x: auto;
      gap: 0.5rem;
      border: 0;
      padding: 0 0 0.5rem;
    }
    .toc a {
      white-space: nowrap;
      padding: 0.45rem 0.85rem;
      border: 1px solid var(--line);
      border-radius: 999px;
    }
    .toc a::before {
      display: none;
    }
    .g {
      grid-template-columns: 1fr;
      padding: 1.5rem 1.25rem;
    }
    .g-phone {
      max-width: 230px;
      order: -1;
    }
  }
</style>
