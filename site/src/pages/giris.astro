---
import Site from '../layouts/Site.astro'
import Brand from '../components/Brand.astro'
import { langOf, translator } from '../lib/i18n'

const t = translator(langOf(Astro.url.pathname))
---

<Site title={t('Giriş · Harcama Atlası', 'Sign in · Harcama Atlası')} description={t('Harcama Atlası hesabına giriş yap ya da yeni hesap oluştur. Uygulamayla aynı hesap.', 'Sign in to your Harcama Atlası account or create a new one. The same account as the app.')} noindex>
  <section class="wrap auth">
    <div class="card panel reveal">
      <div class="top">
        <Brand id="logo-giris" size={40} wordmark={false} />
        <h1 data-title>{t('Hesabına giriş yap', 'Sign in to your account')}</h1>
        <p class="muted" data-sub>{t('Uygulamayla aynı hesap. Paketin ve verilerin her yerde aynı.', 'The same account as the app. Your plan and data are the same everywhere.')}</p>
      </div>

      <div class="tabs" role="tablist" aria-label={t('Giriş ya da kayıt', 'Sign in or sign up')}>
        <button type="button" role="tab" aria-selected="true" data-mode="giris">{t('Giriş yap', 'Sign in')}</button>
        <button type="button" role="tab" aria-selected="false" data-mode="kayit">{t('Hesap oluştur', 'Create account')}</button>
      </div>

      <form class="form" data-form novalidate>
        <div class="field" data-only="kayit" hidden>
          <label for="ad">{t('Adın', 'Your name')}</label>
          <input class="input" id="ad" name="ad" autocomplete="given-name" maxlength="60" />
        </div>
        <div class="field">
          <label for="eposta">{t('E-posta', 'Email')}</label>
          <input class="input" id="eposta" name="eposta" type="email" autocomplete="email" required inputmode="email" />
        </div>
        <div class="field">
          <label for="sifre">{t('Şifre', 'Password')}</label>
          <input class="input" id="sifre" name="sifre" type="password" autocomplete="current-password" required minlength="6" />
        </div>
        <p class="notice" data-msg role="status" aria-live="polite"></p>
        <button class="btn btn-route btn-block" type="submit" data-submit>{t('Giriş yap', 'Sign in')}</button>
        <button class="link" type="button" data-forgot>{t('Şifremi unuttum', 'Forgot my password')}</button>
      </form>

      <div class="or"><span>{t('ya da', 'or')}</span></div>
      <button class="btn btn-ghost btn-block" type="button" data-google>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><path fill="#4285F4" d="M22.6 12.2c0-.8-.1-1.5-.2-2.2H12v4.2h6a5.1 5.1 0 0 1-2.2 3.4v2.8h3.6c2-1.9 3.2-4.7 3.2-8.2z"></path><path
            fill="#34A853"
            d="M12 23c3 0 5.5-1 7.3-2.7l-3.6-2.8c-1 .7-2.2 1.1-3.7 1.1-2.9 0-5.3-1.9-6.2-4.5H2.1v2.9A11 11 0 0 0 12 23z"></path><path
            fill="#FBBC05"
            d="M5.8 14.1a6.6 6.6 0 0 1 0-4.2V7H2.1a11 11 0 0 0 0 10l3.7-2.9z"></path><path
            fill="#EA4335"
            d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.2-3.2A11 11 0 0 0 2.1 7l3.7 2.9C6.7 7.3 9.1 5.4 12 5.4z"></path></svg
        >
        {t('Google ile devam et', 'Continue with Google')}
      </button>
    </div>
  </section>
</Site>

<script>
  import { authMessage, currentUser, local, safeNext, supa, tr } from '../lib/account'
  import { APP_URL } from '../lib/config'

  async function init() {
    const form = document.querySelector<HTMLFormElement>('[data-form]')
    if (!form || form.dataset.ready) return
    form.dataset.ready = '1'
    const t = tr()
    const next = safeNext(new URLSearchParams(location.search).get('sonra'))
    if (await currentUser()) return location.replace(next)

    const msg = document.querySelector<HTMLElement>('[data-msg]')!
    const submit = document.querySelector<HTMLButtonElement>('[data-submit]')!
    const pass = form.querySelector<HTMLInputElement>('#sifre')!
    let mode: 'giris' | 'kayit' = new URLSearchParams(location.search).get('kayit') ? 'kayit' : 'giris'
    const say = (text: string, tone: 'ok' | 'danger' = 'danger') => {
      msg.textContent = text
      msg.dataset.tone = tone
    }
    const setMode = (m: typeof mode) => {
      mode = m
      document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.mode === m)))
      document.querySelectorAll<HTMLElement>('[data-only]').forEach((el) => (el.hidden = el.dataset.only !== m))
      document.querySelector('[data-title]')!.textContent = m === 'giris' ? t('Hesabına giriş yap', 'Sign in to your account') : t('Hesabını oluştur', 'Create your account')
      submit.textContent = m === 'giris' ? t('Giriş yap', 'Sign in') : t('Hesap oluştur', 'Create account')
      pass.autocomplete = m === 'giris' ? 'current-password' : 'new-password'
      ;(document.querySelector('[data-forgot]') as HTMLElement).hidden = m !== 'giris'
      say('')
    }
    document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode as typeof mode)))
    setMode(mode)

    const busy = (on: boolean) => {
      submit.disabled = on
      submit.innerHTML = on
        ? `<span class="spin" aria-hidden="true"></span> ${t('Bekle…', 'Please wait…')}`
        : mode === 'giris'
          ? t('Giriş yap', 'Sign in')
          : t('Hesap oluştur', 'Create account')
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const email = (form.querySelector('#eposta') as HTMLInputElement).value.trim()
      const password = pass.value
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return say(t('Geçerli bir e-posta yaz.', 'Enter a valid email.'))
      if (password.length < 6) return say(t('Şifre en az 6 karakter olmalı.', 'Password must be at least 6 characters.'))
      busy(true)
      try {
        if (mode === 'giris') {
          const { error } = await supa().auth.signInWithPassword({ email, password })
          if (error) throw error
          return location.replace(next)
        }
        const name = (form.querySelector('#ad') as HTMLInputElement).value.trim()
        const { data, error } = await supa().auth.signUp({
          email,
          password,
          options: { data: name ? { full_name: name } : undefined, emailRedirectTo: `${location.origin}${local('/giris')}?sonra=${encodeURIComponent(next)}` },
        })
        if (error) throw error
        if (data.session) return location.replace(next)
        say(t('Hesabın oluşturuldu. E-postana gelen bağlantıya dokunarak doğrula, sonra giriş yap.', 'Your account is created. Verify it with the link we emailed you, then sign in.'), 'ok')
        setTimeout(() => setMode('giris'), 50)
      } catch (err) {
        say(authMessage(err))
      } finally {
        busy(false)
      }
    })

    document.querySelector('[data-forgot]')?.addEventListener('click', async () => {
      const email = (form.querySelector('#eposta') as HTMLInputElement).value.trim()
      if (!email) return say(t('Önce e-postanı yaz.', 'Enter your email first.'))
      // Şifre yenileme uygulamanın kendi ekranında yapılır
      const { error } = await supa().auth.resetPasswordForEmail(email, { redirectTo: `${APP_URL}?sifre=yenile&e=${encodeURIComponent(email)}${document.documentElement.lang === 'en' ? '&dil=en' : ''}` })
      say(error ? authMessage(error) : t('Şifre yenileme bağlantısını e-postana gönderdik.', 'We emailed you a password reset link.'), error ? 'danger' : 'ok')
    })

    document.querySelector('[data-google]')?.addEventListener('click', async () => {
      const { error } = await supa().auth.signInWithOAuth({ provider: 'google', options: { redirectTo: `${location.origin}${local('/giris')}?sonra=${encodeURIComponent(next)}` } })
      if (error) say(authMessage(error))
    })
  }
  document.addEventListener('astro:page-load', init)
</script>

<style>
  .auth {
    display: grid;
    place-items: center;
    padding-block: 3rem 6rem;
  }
  .panel {
    width: 100%;
    max-width: 440px;
    padding: 2rem;
    box-shadow: var(--shadow);
  }
  .top {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .top h1 {
    margin: 0.5rem 0 0;
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .top p {
    margin: 0;
    font-size: 0.95rem;
  }
  .tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 4px;
    border-radius: 999px;
    background: var(--paper-2);
    margin-bottom: 1.25rem;
  }
  .tabs button {
    border: 0;
    border-radius: 999px;
    padding: 0.6rem;
    background: transparent;
    color: var(--ink-2);
    font: 600 0.94rem var(--body);
    cursor: pointer;
  }
  .tabs [aria-selected='true'] {
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 2px 8px -4px rgb(0 0 0 / 0.3);
  }
  .form {
    display: grid;
    gap: 1rem;
  }
  .link {
    justify-self: center;
    border: 0;
    background: none;
    color: var(--ink-2);
    font: 500 0.9rem var(--body);
    text-decoration: underline;
    cursor: pointer;
  }
  .or {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem 0;
    color: var(--ink-2);
    font-size: 0.85rem;
  }
  .or::before,
  .or::after {
    content: '';
    flex: 1;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 480px) {
    .panel {
      padding: 1.5rem 1.25rem;
    }
  }
</style>
