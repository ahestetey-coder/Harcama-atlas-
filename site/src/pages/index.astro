---
import Site from '../layouts/Site.astro'
import Phone from '../components/Phone.astro'
import PriceCards from '../components/PriceCards.astro'
import { contourPaths } from '../lib/contours'
import { langOf, localize, translator } from '../lib/i18n'

const lang = langOf(Astro.url.pathname)
const t = translator(lang)
const L = (p: string) => localize(p, lang)

const rings = [
  ...contourPaths({ cx: 330, cy: 170, rings: 8, r0: 20, step: 24, seed: 1.3 }),
  ...contourPaths({ cx: 110, cy: 500, rings: 6, r0: 16, step: 22, seed: 4.1 }),
]
const route = 'M50 480 C 100 430, 110 380, 150 360 S 230 330, 250 280 S 290 170, 360 140'
const stops = [
  { x: 50, y: 480, label: t('Bugün', 'Today'), sub: t('Konumun', 'You are here') },
  { x: 150, y: 360, label: t('Acil durum fonu', 'Emergency fund'), sub: t('3–6 aylık gider', '3–6 months of expenses') },
  { x: 250, y: 280, label: t('Borçsuz', 'Debt-free'), sub: t('Faizli borç yok', 'No interest-bearing debt') },
  { x: 360, y: 140, label: t('Finansal özgürlük', 'Financial freedom'), sub: t('Zirve', 'The summit') },
]

const markets = [t('Altın', 'Gold'), t('Döviz', 'Currencies'), t('BIST hisse', 'BIST stocks'), t('Yabancı hisse / ETF', 'Foreign stocks / ETFs'), t('TEFAS fon', 'TEFAS funds'), t('Kripto', 'Crypto'), t('Emtia', 'Commodities'), t('Mevduat', 'Deposits')]

const features = [
  { img: 'ozet-light', dark: 'ozet-dark', free: true, chip: t('Ücretsiz', 'Free'), title: t('Paranın haritası tek ekranda', 'Your money on one map'), text: t('Bu ay ne harcadın, bütçende ne kaldı, hangi kategori büyüyor? Özet sayfası hepsini bir bakışta gösterir.', 'What did you spend this month, what is left in your budget, which category is growing? The Summary page shows it all at a glance.') },
  { img: 'islemler-light', free: true, chip: t('Ücretsiz', 'Free'), title: t('Ekstreni yükle, gerisini bırak', 'Upload your statement, we do the rest'), text: t('PDF, Excel, CSV ya da ekran görüntüsü. Harcamalar okunur, kategoriler önerilir, tekrar edenler yakalanır.', 'PDF, Excel, CSV or a screenshot. Transactions are read, categories suggested and duplicates caught.') },
  { img: 'butce-light', chip: 'Plus', title: t('Gelirine göre akıllı bütçe', 'A smart budget based on your income'), text: t('Maaş gününe göre dönem, kategori limitleri ve ay sonu tahmini. Bütçeyi koç kurar, sen onaylarsın.', 'Periods that follow your payday, category limits and a month-end forecast. The coach builds the budget, you approve it.') },
  { img: 'borclar-light', chip: 'Plus', title: t('Borçlar ve taksitler kontrolde', 'Debts and instalments under control'), text: t('Kart taksitleri, krediler ve düzenli ödemeler gelecek aylara yayılmış halde. Hangi ay ne kadar ödeyeceğin belli.', 'Card instalments, loans and recurring payments laid out across the coming months. You always know what is due when.') },
  { img: 'yatirim-ozet-light', dark: 'yatirim-ozet-dark', chip: 'Plus', title: t('Yatırımların canlı fiyatla', 'Your investments at live prices'), text: t('Altın, döviz, fon, hisse, kripto ve emtia. Fiyatlar kendiliğinden güncellenir; maliyetini, güncel değerini ve kâr/zararını TL ya da dolar olarak görürsün.', 'Gold, currencies, funds, stocks, crypto and commodities. Prices update on their own; you see your cost, current value and profit/loss in lira or dollars.') },
  { img: 'finansal-bilgi-light', dark: 'finansal-bilgi-dark', chip: 'Plus+', title: t('Koç ve finansal bilgi', 'Coach and financial know-how'), text: t('Koç senin rakamlarınla plan çıkarır. Finansal bilgi bölümü risk, enflasyon, çeşitlendirme gibi kavramları sade bir dille anlatır.', 'The coach plans with your own numbers. The financial know-how section explains ideas like risk, inflation and diversification in plain language.') },
]

const faqs = [
  { q: t('Finansal Harita testi ücretli mi?', 'Is the Financial Map test free?'), a: t('Hayır. Test ücretsiz, yaklaşık 2 dakika sürer ve 10 sorudan oluşur. Sonucunda finansal arketipini, rotandaki konumunu ve tahmini özgürlük yılını görürsün.', 'Yes. The test is free, takes about 2 minutes and has 10 questions. At the end you see your financial archetype, where you are on your route and your estimated freedom year.') },
  { q: t('Test sonucum uygulamaya nasıl geçiyor?', 'How does my test result get into the app?'), a: t('Testte verdiğin e-posta adresiyle uygulamaya giriş yaptığında sonucun hesabına kendiliğinden bağlanır. İstersen sana verilen devam koduyla da aktarabilirsin.', 'When you sign in to the app with the email you gave in the test, your result is linked to your account automatically. You can also transfer it with the continue code you receive.') },
  { q: t('Banka şifremi istiyor musunuz?', 'Do you ask for my bank password?'), a: t('Hayır. Harcama Atlası bankana bağlanmaz. Harcamalarını ekstre dosyasıyla, ekran görüntüsüyle ya da elle eklersin. Ekran görüntüleri cihazında okunur.', 'No. Harcama Atlası never connects to your bank. You add spending with a statement file, a screenshot or by hand. Screenshots are read on your device.') },
  { q: t('Verilerim nerede saklanıyor?', 'Where is my data stored?'), a: t('Verilerin hesabına bağlı olarak saklanır ve aynı hesapla girdiğin her cihazda görünür. Hesabını ve tüm verilerini dilediğin an uygulamadan silebilirsin.', 'Your data is stored with your account and appears on every device you sign in to. You can delete your account and all your data from the app at any time.') },
  { q: t('Aboneliğimi nereden alırım, nasıl iptal ederim?', 'Where do I subscribe and how do I cancel?'), a: t('Plus ve Plus+ paketlerini bu siteden ya da uygulama mağazasından alabilirsin. Hangi kanaldan aldıysan o kanaldan iptal edersin; iptal ettiğinde dönem sonuna kadar kullanmaya devam edersin.', 'You can buy Plus and Plus+ on this website or in the app store. You cancel through the same channel you bought from, and you keep access until the end of the paid period.') },
  { q: t('Yatırım fiyatları nereden geliyor?', 'Where do investment prices come from?'), a: t('Döviz kurları TCMB’den, altın, hisse, fon, kripto ve emtia fiyatları piyasa kaynaklarından kendiliğinden alınır; uygulama açıkken 15 dakikada bir yenilenir. Fiyatlar gecikmeli olabilir. Bankana ya da aracı kurumuna bağlanmayız, yatırımlarını sen eklersin.', 'Exchange rates come from the Central Bank of Türkiye; gold, stock, fund, crypto and commodity prices come from market sources automatically and refresh every 15 minutes while the app is open. Prices may be delayed. We never connect to your bank or broker; you add your investments yourself.') },
  { q: t('Koç yatırım tavsiyesi veriyor mu?', 'Does the coach give investment advice?'), a: t('Hayır. Koç bütçe, borç kapatma ve birikim planı konusunda yol gösterir; belirli bir hisse, fon ya da coin almanı veya satmanı önermez.', 'No. The coach guides you on budgeting, paying off debt and saving; it never tells you to buy or sell a specific stock, fund or coin.') },
]
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'SoftwareApplication', name: 'Harcama Atlası', applicationCategory: 'FinanceApplication', operatingSystem: 'iOS, Android, Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' } },
    { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ],
}
---

<Site
  title={t('Harcama Atlası · Harcamalarını haritala, özgürlüğe giden rotanı çiz', 'Harcama Atlası · Map your spending, chart your route to freedom')}
  description={t('Harcamalarını tek ekranda topla, 2 dakikalık Finansal Harita testiyle özgürlük rotanı çıkar. Ücretsiz başla.', 'See all your spending on one screen and chart your route to financial freedom with a 2-minute Financial Map test. Start free.')}
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow reveal">{t('Kişisel finans atlası', 'Your personal finance atlas')}</p>
      {
        lang === 'en' ? (
          <h1 class="h-display reveal" style="--d:1">Map your spending, chart your <span class="accent">route to freedom</span>.</h1>
        ) : (
          <h1 class="h-display reveal" style="--d:1">Harcamalarını haritala, <span class="accent">özgürlüğe giden rotanı</span> çiz.</h1>
        )
      }
      <p class="lead reveal" style="--d:2">
        {t('Harcama Atlası paranın nereye gittiğini tek haritada toplar. 2 dakikalık Finansal Harita testiyle ilk rotanı çıkarır, uygulamada her ay nerede olduğunu gösterir.', 'Harcama Atlası puts everywhere your money goes on one map. A 2-minute Financial Map test charts your first route, and the app shows where you stand every month.')}
      </p>
      <div class="ctas reveal" style="--d:3">
        <a class="btn btn-route" href={L('/test')}>{t('Finansal Harita testini çöz', 'Take the Financial Map test')} <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="#nasil">{t('Nasıl çalışır?', 'How does it work?')}</a>
      </div>
      <ul class="proof reveal" style="--d:4" aria-label={t('Öne çıkanlar', 'Highlights')}>
        {
          lang === 'en' ? (
            <>
              <li><strong>10 questions</strong> · 2 minutes</li>
              <li><strong>Lira, dollars</strong> or gold</li>
              <li><strong>iOS, Android</strong> and web</li>
            </>
          ) : (
            <>
              <li><strong>10 soru</strong> · 2 dakika</li>
              <li><strong>TL, dolar</strong> ya da altın</li>
              <li><strong>iOS, Android</strong> ve web</li>
            </>
          )
        }
      </ul>
      <div class="stores reveal" style="--d:5" aria-label={t('Uygulamayı indir', 'Download the app')}>
        <span class="store"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5a4.3 4.3 0 0 0-3.4-1.8c-1.4-.2-2.8.8-3.5.8-.7 0-1.8-.8-3-.8a4.5 4.5 0 0 0-3.8 2.3c-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.3a10 10 0 0 0 1.3-2.6 4 4 0 0 1-2.5-3.7ZM14.1 5.8A4 4 0 0 0 15 2.9a4.1 4.1 0 0 0-2.7 1.4 3.9 3.9 0 0 0-1 2.8 3.4 3.4 0 0 0 2.8-1.3Z"></path></svg><span>App Store<small>{t('yakında', 'coming soon')}</small></span></span>
        <span class="store"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M3.6 2.3 13.4 12l-9.8 9.7a1.5 1.5 0 0 1-.6-1.2V3.5c0-.5.2-.9.6-1.2Zm11 8.5 2.6-2.6 3.2 1.8c1.1.6 1.1 1.7 0 2.3l-3.2 1.9-2.6-2.6L13.4 12l1.2-1.2ZM5 1.6l10.5 6-2.1 2.1L5 1.6Zm8.4 12.8 2.1 2.1L5 22.4l8.4-8Z"></path></svg><span>Google Play<small>{t('yakında', 'coming soon')}</small></span></span>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="map card">
        <svg viewBox="0 0 560 600" class="map-svg">
          <defs>
            <pattern id="grid" width="56" height="60" patternUnits="userSpaceOnUse"><path d="M56 0H0V60" fill="none" class="gridline"></path></pattern>
          </defs>
          <rect width="560" height="600" fill="url(#grid)"></rect>
          <g class="contours">{rings.map((d) => <path d={d} />)}</g>
          <text x="10" y="18" class="coord">41°N</text><text x="10" y="138" class="coord">40°N</text><text x="494" y="590" class="coord">29°E</text>
          <path d={route} class="route-shadow"></path>
          <path d={route} class="route" pathLength="1"></path>
          {
            stops.map((s, i) => (
              <g class="stop" data-at={[0, 0.38, 0.6, 0.97][i]} transform={`translate(${s.x} ${s.y})`}>
                <circle r="11" class="stop-halo" />
                <circle r="6.5" class="stop-dot" />
                <text x={i === 3 ? -16 : 16} y="-3" text-anchor={i === 3 ? 'end' : 'start'} class="stop-label">{s.label}</text>
                <text x={i === 3 ? -16 : 16} y="14" text-anchor={i === 3 ? 'end' : 'start'} class="stop-sub">{s.sub}</text>
              </g>
            ))
          }
          <g class="compass" transform="translate(500 70)">
            <circle r="26" class="c-ring"></circle>
            <path d="M0 -20 L5 0 L0 20 L-5 0 Z" class="c-needle"></path>
            <text y="-32" text-anchor="middle" class="coord">{t('K', 'N')}</text>
          </g>
        </svg>
      </div>
      <div class="hero-phone" data-tilt>
        <Phone light="ozet-light" dark="ozet-dark" alt="" eager />
      </div>
    </div>
  </section>

  <!-- NASIL ÇALIŞIR -->
  <section id="nasil" class="how wrap">
    <p class="eyebrow reveal">{t('Nasıl çalışır', 'How it works')}</p>
    {
      lang === 'en' ? (
        <h2 class="h-section reveal">Your <span class="accent">route</span> in three steps</h2>
      ) : (
        <h2 class="h-section reveal">Üç adımda <span class="accent">rotan</span> hazır</h2>
      )
    }
    <ol class="steps">
      <li class="reveal" style="--d:0">
        <span class="n">01</span>
        <h3>{t('Harcamanı haritala', 'Map your spending')}</h3>
        <p>{t('Ekstreni, ekran görüntüsünü ya da harcamanı tek tek ekle. Kategoriler kendiliğinden oluşur.', 'Add your statement, a screenshot or each expense by hand. Categories are filled in for you.')}</p>
      </li>
      <li class="reveal" style="--d:1">
        <span class="n">02</span>
        <h3>{t('Testi çöz', 'Take the test')}</h3>
        <p>{t('10 kısa soruyla konumunu ve hedefini belirle. Sonuç TL, dolar ya da altın cinsinden.', 'Ten short questions set where you are and where you are heading. Results in lira, dollars or gold.')}</p>
      </li>
      <li class="reveal" style="--d:2">
        <span class="n">03</span>
        <h3>{t('Rotanı izle', 'Follow your route')}</h3>
        <p>{t('Her ay hangi durakta olduğunu ve sıradaki hedefe ne kadar kaldığını gör.', 'Each month, see which stop you are at and how far the next one is.')}</p>
      </li>
    </ol>
  </section>

  <!-- TEST VİTRİNİ -->
  <section class="band">
    <div class="wrap test-grid">
      <div class="test-phone reveal">
        <Phone light="test-soru-1" alt={t('Finansal Harita testinin çözülüşü', 'Taking the Financial Map test')}>
          <video data-autoplay muted loop playsinline preload="none" poster="/screenshots/test-soru-1.webp" aria-label={t('Finansal Harita testinin çözülüşünü gösteren kısa video', 'Short video of the Financial Map test being taken')}>
            <source src="/video/harita-testi.webm" type="video/webm" />
            <source src="/video/harita-testi.mp4" type="video/mp4" />
          </video>
        </Phone>
        <div class="float-card card" aria-hidden="true">
          <span class="chip">{t('Sonuç', 'Result')}</span>
          <strong>{t('Temkinli Kaşif', 'Cautious Explorer')}</strong>
          <span>{t('Özgürlük yılı', 'Freedom year')} <b>2035</b></span>
        </div>
      </div>
      <div class="test-text">
        <p class="eyebrow reveal">{t('Finansal Harita testi', 'Financial Map test')}</p>
        {
          lang === 'en' ? (
            <h2 class="h-section reveal">Chart your <span class="accent">financial map</span> in 2 minutes.</h2>
          ) : (
            <h2 class="h-section reveal">2 dakikada <span class="accent">finansal haritanı</span> çıkar.</h2>
          )
        }
        <p class="lead reveal">{t('Sorular kısa ve görsel. Sonunda finansal arketipini, rotandaki konumunu ve bugünkü tempoyla özgürlük yılını görürsün.', 'Short, visual questions. At the end you see your financial archetype, where you are on your route and your freedom year at today’s pace.')}</p>
        <ul class="ticks reveal">
          <li>{t('Gelir, birikim, borç ve risk alışkanlığına göre kişisel sonuç', 'A personal result based on your income, savings, debt and risk habits')}</li>
          <li>{t('Hedefini TL, dolar ya da gram altın cinsinden gör', 'See your goal in lira, dollars or grams of gold')}</li>
          <li>{t('Sonucun, aynı e-postayla girdiğin uygulamada seni bekler', 'Your result waits for you in the app when you sign in with the same email')}</li>
        </ul>
        <a class="btn btn-route reveal" href={L('/test')}>{t('Testi ücretsiz çöz', 'Take the test for free')} <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ÖZELLİKLER -->
  <section class="features wrap" id="ozellikler">
    <p class="eyebrow reveal">{t('Özellikler', 'Features')}</p>
    {
      lang === 'en' ? (
        <h2 class="h-section reveal">Everything you need<br />to understand your money</h2>
      ) : (
        <h2 class="h-section reveal">Paranı anlamak için<br />ihtiyacın olan her şey</h2>
      )
    }
    <div class="feat-grid">
      <div class="feat-list">
        {
          features.map((f, i) => (
            <article class="feat" data-i={i}>
              <div class="feat-phone-m">
                <Phone light={f.img} dark={f.dark} alt={f.title} />
              </div>
              <span class:list={['chip', { 'chip-route': !f.free }]}>{f.chip}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
      <div class="feat-sticky" aria-hidden="true">
        <div class="feat-stage">
          {
            features.map((f, i) => (
              <div class:list={['feat-shot', { on: i === 0 }]} data-i={i}>
                <Phone light={f.img} dark={f.dark} alt="" />
              </div>
            ))
          }
          <ol class="feat-dots">{features.map((_, i) => <li class:list={[{ on: i === 0 }]} data-i={i} />)}</ol>
        </div>
      </div>
    </div>
  </section>

  <!-- KOÇ -->
  <section class="invest wrap" id="yatirimlar">
    <div class="invest-card card">
      <div class="invest-text">
        <span class="chip chip-route reveal">Plus</span>
        {
          lang === 'en' ? (
            <h2 class="h-section reveal">Your investments, <span class="accent">at live prices</span></h2>
          ) : (
            <h2 class="h-section reveal">Yatırımların <span class="accent">canlı fiyatla</span> tek yerde</h2>
          )
        }
        <p class="lead reveal">{t('Ne aldığını, kaça aldığını yaz; gerisini uygulama yapar. Güncel değer, kâr/zarar ve dağılım her açılışta kendiliğinden yenilenir.', 'Enter what you bought and at what price; the app does the rest. Current value, profit/loss and your mix refresh by themselves every time you open it.')}</p>
        <ul class="markets reveal" aria-label={t('Desteklenen yatırım türleri', 'Supported investment types')}>
          {markets.map((m) => <li>{m}</li>)}
        </ul>
        <ul class="ticks reveal">
          <li>{t('Adını yazınca sembol önerilir: THYAO, SPY, TTE, BTC…', 'Type a name and the symbol is suggested: THYAO, SPY, TTE, BTC…')}</li>
          <li>{t('Maliyetin, güncel değerin ve kâr/zararın tutar ve yüzde olarak', 'Your cost, current value and profit/loss as an amount and a percentage')}</li>
          <li>{t('Toplamı TL ya da dolar olarak gör, dağılımı grafikte izle', 'See your total in lira or dollars and follow your mix on a chart')}</li>
        </ul>
        <p class="note reveal">{t('Fiyatlar gecikmeli olabilir. Yatırım tavsiyesi değildir.', 'Prices may be delayed. Not investment advice.')}</p>
      </div>
      <div class="invest-phones">
        <div class="invest-back reveal" style="--d:2">
          <Phone light="yatirim-ekle-light" dark="yatirim-ekle-dark" alt={t('Yatırım ekleme ekranı', 'The add investment screen')} />
        </div>
        <div class="invest-front reveal" style="--d:1">
          <Phone light="yatirim-liste-light" dark="yatirim-liste-dark" alt={t('Yatırımlarım listesinde güncel fiyat ve kâr/zarar', 'Current prices and profit/loss in the My investments list')} />
        </div>
        <div class="float-card card pl" aria-hidden="true">
          <span class="chip">{t('Gram altın', 'Gold (gram)')}</span>
          <strong>+52.720 ₺</strong>
          <span>{t('Kâr', 'Profit')} <b>%30,7</b></span>
        </div>
      </div>
    </div>
  </section>

  <section class="coach wrap">
    <div class="coach-card card">
      <div class="coach-text">
        <span class="chip chip-route reveal">Plus+</span>
        {
          lang === 'en' ? (
            <h2 class="h-section reveal">A <span class="accent">finance coach</span> who knows you</h2>
          ) : (
            <h2 class="h-section reveal">Seni tanıyan bir <span class="accent">finans koçu</span></h2>
          )
        }
        <p class="lead reveal">{t('Koç; gelirini, giderlerini, borçlarını ve test sonucunu bilir. Borç kapatma sırası, ayrılacak birikim ve sıradaki durak için sana özel plan çıkarır.', 'The coach knows your income, expenses, debts and test result. It builds a plan just for you: which debt to pay off first, how much to save and your next stop.')}</p>
        <ul class="ticks reveal">
          <li>{t('Borç kapatma sırası ve aylık birikim tutarı', 'Which debt to pay off first and how much to save each month')}</li>
          <li>{t('Yatırımların, borçların ve rotan tek planda', 'Your investments, debts and route in one plan')}</li>
          <li>{t('Finansal bilgi: risk, enflasyon, çeşitlendirme sade dille', 'Financial know-how: risk, inflation and diversification in plain words')}</li>
        </ul>
        <p class="note reveal">{t('Koç yatırım tavsiyesi vermez; hesapları uygulamanın kendi motoru yapar.', 'The coach does not give investment advice; all calculations are done by the app’s own engine.')}</p>
      </div>
      <div class="chat" aria-label={t('Örnek koç sohbeti', 'Sample coach conversation')}>
        <div class="msg me reveal" style="--d:0">{t('Kredi kartı borcumu mu kapatayım, birikime mi başlayayım?', 'Should I pay off my credit card or start saving?')}</div>
        <div class="msg bot reveal" style="--d:2">
          {
            lang === 'en' ? (
