---
import '@fontsource-variable/plus-jakarta-sans'
import '@fontsource-variable/inter'
import '../styles/site.css'
import { ClientRouter } from 'astro:transitions'
// Başlık yazı tipleri erken indirilir; büyük başlık yazı tipini beklerken boyanmıyordu (LCP)
import jakartaLatin from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url'
import jakartaLatinExt from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-ext-wght-normal.woff2?url'
import Brand from '../components/Brand.astro'
import Consent from '../components/Consent.astro'
import { counterpart, langOf, localize, translator } from '../lib/i18n'

interface Props {
  title: string
  description: string
  jsonLd?: object
  /** Hesap ve ödeme sayfaları arama motorlarında listelenmez. */
  noindex?: boolean
  /** Paylaşım görseli (site köküne göre yol) */
  image?: string
  /** Blog yazılarında 'article' */
  ogType?: 'website' | 'article'
}
const { title, description, jsonLd, noindex, image = '/og.png', ogType = 'website' } = Astro.props
const site = Astro.site ?? new URL(Astro.url.origin)
const lang = langOf(Astro.url.pathname)
const t = translator(lang)
const L = (p: string) => localize(p, lang)
const other = counterpart(Astro.url.pathname)
// Cloudflare Pages klasör sayfalarını sondaki eğik çizgiyle sunar
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), site).href
// İngilizce sayfalarda paylaşım görseli İngilizce (Spending Atlas)
const ogImage = new URL(lang === 'en' && image === '/og.png' ? '/og-en.png' : image, site).href
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${site.href}#org`, name: t('Harcama Atlası', 'Spending Atlas'), url: site.href, logo: new URL('/apple-touch-icon.png', site).href },
    { '@type': 'WebSite', '@id': `${site.href}#site`, name: t('Harcama Atlası', 'Spending Atlas'), url: site.href, inLanguage: lang === 'en' ? 'en' : 'tr-TR', publisher: { '@id': `${site.href}#org` } },
  ],
}
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const nav = [
  { href: L('/#nasil'), label: t('Nasıl çalışır', 'How it works') },
  { href: L('/fiyatlar'), label: t('Fiyatlar', 'Pricing') },
  { href: L('/nasil-kullanilir'), label: t('Nasıl kullanılır', 'Guide') },
  // Blog yazıları yalnızca Türkçe
  ...(lang === 'tr' ? [{ href: '/blog', label: 'Blog' }] : []),
  { href: L('/#sss'), label: t('SSS', 'FAQ') },
]
const legal = [
  ['/yasal/kvkk', 'KVKK Aydınlatma Metni', 'KVKK Privacy Notice'],
  ['/yasal/acik-riza', 'Açık Rıza Metni', 'Explicit Consent'],
  ['/yasal/gizlilik', 'Gizlilik Politikası', 'Privacy Policy'],
  ['/yasal/cerez', 'Çerez Politikası', 'Cookie Policy'],
  ['/yasal/kullanim-kosullari', 'Kullanım Koşulları', 'Terms of Use'],
  ['/yasal/on-bilgilendirme', 'Ön Bilgilendirme Formu', 'Pre-Information Form'],
  ['/yasal/mesafeli-satis', 'Mesafeli Satış Sözleşmesi', 'Distance Sales Agreement'],
  ['/yasal/iptal-iade', 'İptal ve İade', 'Cancellation and Refunds'],
]
const alt = (href: string) => new URL(href, site).href
---

<!doctype html>
<html lang={lang} data-theme="dark" data-alt={other.exists ? other.href : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t('Harcama Atlası', 'Spending Atlas')} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'tr_TR'} />
    {!noindex && other.exists && <link rel="alternate" hreflang={other.lang} href={alt(other.href)} />}
    {!noindex && other.exists && <link rel="alternate" hreflang={lang} href={canonical} />}
    {!noindex && other.exists && <link rel="alternate" hreflang="x-default" href={lang === 'tr' ? canonical : alt(other.href)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {lang === 'tr' && <link rel="alternate" type="application/rss+xml" title="Harcama Atlası Blog" href="/blog/rss.xml" />}
    <meta name="theme-color" content="#0d1722" />
    {[jakartaLatin, jakartaLatinExt].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // İlk ziyarette dil: Türkçe konuşulan yerlerde (cihaz dili tr ya da Türkiye/Kıbrıs saat dilimi) Türkçe, diğerlerinde İngilizce.
      // Elle seçilen dil (dil düğmesi ya da ?dil=) her zaman kazanır ve hatırlanır. Arama motoru botları yönlendirilmez.
      ;(function () {
        const KEY = 'ha-site-lang'
        const root = document.documentElement
        let saved = null
        try {
          const q = new URLSearchParams(location.search).get('dil')
          if (q === 'tr' || q === 'en') localStorage.setItem(KEY, q)
          saved = localStorage.getItem(KEY)
        } catch { /* tercih okunamadı */ }
        document.addEventListener('click', (e) => {
          const a = e.target instanceof Element && e.target.closest('[data-lang-switch]')
          if (!a) return
          try { localStorage.setItem(KEY, a.getAttribute('hreflang') === 'en' ? 'en' : 'tr') } catch { /* kaydedilemedi */ }
        }, true)
        if (/bot|crawl|spider|slurp|lighthouse|preview/i.test(navigator.userAgent)) return
        let want = saved === 'tr' || saved === 'en' ? saved : null
        if (!want) {
          let tz = ''
          try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '' } catch { /* saat dilimi yok */ }
          const langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || '']
          const tr = langs.some((l) => /^tr\b|-tr$/i.test(l)) || ['Europe/Istanbul', 'Asia/Istanbul', 'Asia/Nicosia', 'Asia/Famagusta', 'Europe/Nicosia'].includes(tz)
          want = tr ? 'tr' : 'en'
        }
        const alt = root.dataset.alt
        if (want !== root.lang && alt) location.replace(alt + location.search.replace(/([?&])dil=[^&]*&?/, '$1').replace(/[?&]$/, '') + location.hash)
      })()
    </script>
    <script is:inline>
      ;(function () {
        const apply = () => {
          document.documentElement.classList.add('js')
          try {
            const q = new URLSearchParams(location.search).get('tema')
            const t = q === 'koyu' ? 'dark' : q === 'acik' ? 'light' : localStorage.getItem('ha-site-theme')
            // Seçim yapılmadıysa site koyu açılır
            document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark'
          } catch { /* tercih okunamadı; koyu tema kalır */ }
        }
        apply()
        document.addEventListener('astro:after-swap', apply)
      })()
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#icerik">{t('İçeriğe geç', 'Skip to content')}</a>
    <header class="site-head" transition:persist>
      <div class="wrap bar">
        <a href={L('/')} class="brand" aria-label={t('Harcama Atlası ana sayfa', 'Spending Atlas home')}>
          <Brand id="logo-ust" size={34} />
        </a>
        <nav class="links" aria-label={t('Ana menü', 'Main menu')}>
          {nav.map((n) => <a href={n.href} aria-current={path === n.href || (n.href === '/blog' && path.startsWith('/blog/')) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="actions">
          <a class="lang-btn" href={other.href} hreflang={other.lang} lang={other.lang} data-lang-switch aria-label={t('Switch to English', 'Türkçeye geç')}>{other.lang.toUpperCase()}</a>
          <button class="icon-btn" type="button" data-theme-toggle aria-label={t('Temayı değiştir', 'Toggle theme')}>
            <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
              ><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
                d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path></svg
            >
            <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
              ><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg
            >
          </button>
          <a class="acct" href={L('/giris')} data-account>{t('Giriş yap', 'Sign in')}</a>
          <a class="btn btn-sm head-cta" href={L('/test')}>{t('Testi çöz', 'Take the test')}</a>
          <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="mobil-menu" aria-label={t('Menüyü aç', 'Open menu')}>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </button>
        </div>
      </div>
      <nav id="mobil-menu" class="mobile" aria-label={t('Mobil menü', 'Mobile menu')} hidden>
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={L('/giris')} data-account>{t('Giriş yap', 'Sign in')}</a>
        <a href={other.href} hreflang={other.lang} lang={other.lang} data-lang-switch>{other.lang === 'en' ? 'English' : 'Türkçe'}</a>
        <a class="btn btn-route" href={L('/test')}>{t('Finansal Harita testini çöz', 'Take the Financial Map test')}</a>
      </nav>
    </header>

    <main id="icerik">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div>
          <a href={L('/')} class="brand" aria-label={t('Harcama Atlası ana sayfa', 'Spending Atlas home')}><Brand id="logo-alt" /></a>
          <p>{t('Harcamalarını haritala, özgürlüğe giden rotanı çiz.', 'Map your spending, chart your route to financial freedom.')}</p>
          <p class="small">{t('Harcama Atlası yatırım danışmanlığı yapmaz; gösterilen hesaplar örnek ve tahmindir.', 'Spending Atlas does not provide investment advice; figures shown are examples and estimates.')}</p>
        </div>
        <nav aria-label={t('Ürün', 'Product')}>
          <h2>{t('Ürün', 'Product')}</h2>
          <a href={L('/test')}>{t('Finansal Harita testi', 'Financial Map test')}</a>
          <a href={L('/fiyatlar')}>{t('Fiyatlar', 'Pricing')}</a>
          <a href={L('/nasil-kullanilir')}>{t('Nasıl kullanılır', 'Guide')}</a>
          {lang === 'tr' && <a href="/blog">Blog</a>}
          <a href={L('/hesap/abonelik')}>{t('Aboneliğim', 'My subscription')}</a>
        </nav>
        <nav aria-label={t('Yasal', 'Legal')}>
          <h2>{t('Yasal', 'Legal')}</h2>
          {legal.map(([href, tr, en]) => <a href={L(href)}>{t(tr, en)}</a>)}
        </nav>
      </div>
      <div class="wrap copy">© 2026 {t('Harcama Atlası', 'Spending Atlas')} <a href={L('/yasal/cerez')} data-consent-open hidden>{t('Çerez tercihleri', 'Cookie preferences')}</a></div>
    </footer>
    <Consent />
  </body>
</html>

<script>
  import { AUTH_STORAGE_KEY } from '../lib/config'
  import { localize, pageLang, translator } from '../lib/i18n'
  const root = document.documentElement
  const mql = matchMedia('(prefers-color-scheme: dark)')
  const isDark = () => root.dataset.theme === 'dark' || (!root.dataset.theme && mql.matches)

  // Oturum açıksa "Giriş yap" yerine "Hesabım" görünür (yalnızca yerel anahtara bakılır, ağ isteği yok)
  function accountLink() {
    let signedIn = false
    try {
      signedIn = !!localStorage.getItem(AUTH_STORAGE_KEY)
    } catch { /* depolama kapalı; giriş bağlantısı kalır */ }
    const lang = pageLang()
    const t = translator(lang)
    document.querySelectorAll<HTMLAnchorElement>('[data-account]').forEach((a) => {
      a.href = localize(signedIn ? '/hesap/abonelik' : '/giris', lang)
      a.textContent = signedIn ? t('Hesabım', 'My account') : t('Giriş yap', 'Sign in')
    })
  }

  function init() {
    // Tema düğmesi
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark'
      const go = () => {
        root.dataset.theme = next
        document.dispatchEvent(new CustomEvent('ha:theme', { detail: next }))
        try {
          localStorage.setItem('ha-site-theme', next)
        } catch { /* kaydedilemedi; seçim bu sayfada geçerli */ }
      }
      const d = document as Document & { startViewTransition?: (cb: () => void) => void }
      if (d.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.startViewTransition(go)
      else go()
    })

    // Mobil menü
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn')
    const menu = document.getElementById('mobil-menu')
    if (btn && menu) {
      const set = (open: boolean) => {
        menu.hidden = !open
        btn.setAttribute('aria-expanded', String(open))
        const t = translator(pageLang())
        btn.setAttribute('aria-label', open ? t('Menüyü kapat', 'Close menu') : t('Menüyü aç', 'Open menu'))
      }
      btn.onclick = () => set(menu.hidden !== false)
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)))
      document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false))
    }
  }
  document.addEventListener('astro:page-load', init, { once: true })

  let scrollBound = false
  function onPage() {
    accountLink()
    // Başlık: kaydırınca yoğunlaşır
    const head = document.querySelector('.site-head')
    const onScroll = () => head?.classList.toggle('scrolled', scrollY > 8)
    onScroll()
    if (!scrollBound) addEventListener('scroll', onScroll, { passive: true })
    scrollBound = true

    // Beliren öğeler
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in')
            io.unobserve(e.target)
          }
        }),
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
    )
    document.querySelectorAll('.reveal:not(.in)').forEach((el) => io.observe(el))

    // Videolar yalnızca görünürken oynar
    const vio = new IntersectionObserver((es) =>
      es.forEach((e) => {
        const v = e.target as HTMLVideoElement
        if (e.isIntersecting && !matchMedia('(prefers-reduced-motion: reduce)').matches) v.play().catch(() => {})
        else v.pause()
      }),
    )
    document.querySelectorAll('video[data-autoplay]').forEach((v) => vio.observe(v))
  }
  document.addEventListener('astro:page-load', onPage)
</script>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 0.5rem;
    background: var(--ink);
    color: var(--paper);
  }
  .skip:focus {
    top: 1rem;
  }
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background 0.3s, box-shadow 0.3s;
  }
  .site-head:global(.scrolled) {
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
  }
  .links {
    display: flex;
    gap: 1.6rem;
    margin-left: auto;
  }
  .links a {
    position: relative;
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--route);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--ink);
  }
  .links a:hover::after,
  .links a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: var(--paper-2);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
  }
  .menu-btn {
    display: none;
  }
  .mobile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 1rem 1.25rem;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .mobile[hidden] {
    display: none;
  }
  .mobile a:not(.btn) {
    padding: 0.8rem 0.25rem;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile .btn {
    margin-top: 1rem;
  }
  .lang-btn {
    display: inline-grid;
    place-items: center;
    height: 2.6rem;
    min-width: 2.6rem;
    padding: 0 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .lang-btn:hover {
    background: var(--paper-2);
  }
  .acct {
    color: var(--ink-2);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.4rem 0.3rem;
  }
  .acct:hover {
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .links,
    .acct {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
    .menu-btn {
      display: inline-grid;
    }
  }
  @media (max-width: 420px) {
    .head-cta {
      display: none;
    }
  }
  .site-foot {
    margin-top: 6rem;
    padding: 4rem 0 2rem;
    border-top: 1px solid var(--line);
    background: var(--paper-2);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
  }
  .foot-grid p {
    color: var(--ink-2);
    max-width: 24rem;
  }
  .small {
    font-size: 0.85rem;
  }
  .foot-grid nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .foot-grid h2 {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 0.5rem;
  }
  .foot-grid nav a {
    text-decoration: none;
    color: var(--ink);
    font-size: 0.95rem;
  }
  .foot-grid nav a:hover {
    color: var(--route);
  }
  .copy a {
    margin-left: 1rem;
    color: inherit;
  }
  .copy {
    margin-top: 3rem;
    color: var(--ink-2);
    font-size: 0.85rem;
  }
  @media (max-width: 760px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot-grid > div {
      grid-column: 1 / -1;
    }
  }
</style>
