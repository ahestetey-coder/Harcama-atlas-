---
import '@fontsource-variable/plus-jakarta-sans'
import '@fontsource-variable/inter'
import '../styles/site.css'
import { ClientRouter } from 'astro:transitions'
import Brand from '../components/Brand.astro'

interface Props {
  title: string
  description: string
  jsonLd?: object
  /** Hesap ve ödeme sayfaları arama motorlarında listelenmez. */
  noindex?: boolean
}
const { title, description, jsonLd, noindex } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const nav = [
  { href: '/#nasil', label: 'Nasıl çalışır' },
  { href: '/fiyatlar', label: 'Fiyatlar' },
  { href: '/nasil-kullanilir', label: 'Nasıl kullanılır' },
  { href: '/#sss', label: 'SSS' },
]
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1722" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      ;(function () {
        const apply = () => {
          document.documentElement.classList.add('js')
          try {
            const q = new URLSearchParams(location.search).get('tema')
            const t = q === 'koyu' ? 'dark' : q === 'acik' ? 'light' : localStorage.getItem('ha-site-theme')
            if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t
          } catch { /* tercih okunamadı; sistem teması kullanılır */ }
        }
        apply()
        document.addEventListener('astro:after-swap', apply)
      })()
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <header class="site-head" transition:persist>
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="Harcama Atlası ana sayfa">
          <Brand id="logo-ust" size={34} />
        </a>
        <nav class="links" aria-label="Ana menü">
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="actions">
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Temayı değiştir">
            <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
              ><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
                d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"></path></svg
            >
            <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
              ><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg
            >
          </button>
          <a class="acct" href="/giris" data-account>Giriş yap</a>
          <a class="btn btn-sm head-cta" href="/test">Testi çöz</a>
          <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="mobil-menu" aria-label="Menüyü aç">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </button>
        </div>
      </div>
      <nav id="mobil-menu" class="mobile" aria-label="Mobil menü" hidden>
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/giris" data-account>Giriş yap</a>
        <a class="btn btn-route" href="/test">Finansal Harita testini çöz</a>
      </nav>
    </header>

    <main id="icerik">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div>
          <a href="/" class="brand" aria-label="Harcama Atlası ana sayfa"><Brand id="logo-alt" /></a>
          <p>Harcamalarını haritala, özgürlüğe giden rotanı çiz.</p>
          <p class="small">Harcama Atlası yatırım danışmanlığı yapmaz; gösterilen hesaplar örnek ve tahmindir.</p>
        </div>
        <nav aria-label="Ürün">
          <h2>Ürün</h2>
          <a href="/test">Finansal Harita testi</a>
          <a href="/fiyatlar">Fiyatlar</a>
          <a href="/nasil-kullanilir">Nasıl kullanılır</a>
          <a href="/hesap/abonelik">Aboneliğim</a>
        </nav>
        <nav aria-label="Yasal">
          <h2>Yasal</h2>
          <a href="/yasal/kvkk">KVKK Aydınlatma Metni</a>
          <a href="/yasal/gizlilik">Gizlilik Politikası</a>
          <a href="/yasal/cerez">Çerez Politikası</a>
          <a href="/yasal/kullanim-kosullari">Kullanım Koşulları</a>
          <a href="/yasal/mesafeli-satis">Mesafeli Satış Sözleşmesi</a>
          <a href="/yasal/iptal-iade">İptal ve İade</a>
        </nav>
      </div>
      <div class="wrap copy">© 2026 Harcama Atlası</div>
    </footer>
  </body>
</html>

<script>
  import { AUTH_STORAGE_KEY } from '../lib/config'
  const root = document.documentElement
  const mql = matchMedia('(prefers-color-scheme: dark)')
  const isDark = () => root.dataset.theme === 'dark' || (!root.dataset.theme && mql.matches)

  // Oturum açıksa "Giriş yap" yerine "Hesabım" görünür (yalnızca yerel anahtara bakılır, ağ isteği yok)
  function accountLink() {
    let signedIn = false
    try {
      signedIn = !!localStorage.getItem(AUTH_STORAGE_KEY)
    } catch { /* depolama kapalı; giriş bağlantısı kalır */ }
    document.querySelectorAll<HTMLAnchorElement>('[data-account]').forEach((a) => {
      a.href = signedIn ? '/hesap/abonelik' : '/giris'
      a.textContent = signedIn ? 'Hesabım' : 'Giriş yap'
    })
  }

  function init() {
    // Tema düğmesi
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark'
      const go = () => {
        root.dataset.theme = next
        document.dispatchEvent(new CustomEvent('ha:theme', { detail: next }))
        try {
          localStorage.setItem('ha-site-theme', next)
        } catch { /* kaydedilemedi; seçim bu sayfada geçerli */ }
      }
      const d = document as Document & { startViewTransition?: (cb: () => void) => void }
      if (d.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.startViewTransition(go)
      else go()
    })

    // Mobil menü
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn')
    const menu = document.getElementById('mobil-menu')
    if (btn && menu) {
      const set = (open: boolean) => {
        menu.hidden = !open
        btn.setAttribute('aria-expanded', String(open))
        btn.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç')
      }
      btn.onclick = () => set(menu.hidden !== false)
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)))
      document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false))
    }
  }
  document.addEventListener('astro:page-load', init, { once: true })

  let scrollBound = false
  function onPage() {
    accountLink()
    // Başlık: kaydırınca yoğunlaşır
    const head = document.querySelector('.site-head')
    const onScroll = () => head?.classList.toggle('scrolled', scrollY > 8)
    onScroll()
    if (!scrollBound) addEventListener('scroll', onScroll, { passive: true })
    scrollBound = true

    // Beliren öğeler
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in')
            io.unobserve(e.target)
          }
        }),
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
    )
    document.querySelectorAll('.reveal:not(.in)').forEach((el) => io.observe(el))

    // Videolar yalnızca görünürken oynar
    const vio = new IntersectionObserver((es) =>
      es.forEach((e) => {
        const v = e.target as HTMLVideoElement
        if (e.isIntersecting && !matchMedia('(prefers-reduced-motion: reduce)').matches) v.play().catch(() => {})
        else v.pause()
      }),
    )
    document.querySelectorAll('video[data-autoplay]').forEach((v) => vio.observe(v))
  }
  document.addEventListener('astro:page-load', onPage)
</script>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 0.5rem;
    background: var(--ink);
    color: var(--paper);
  }
  .skip:focus {
    top: 1rem;
  }
  .site-head {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background 0.3s, box-shadow 0.3s;
  }
  .site-head:global(.scrolled) {
    background: color-mix(in oklab, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
  }
  .links {
    display: flex;
    gap: 1.6rem;
    margin-left: auto;
  }
  .links a {
    position: relative;
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--route);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--ink);
  }
  .links a:hover::after,
  .links a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: var(--paper-2);
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
  }
  .menu-btn {
    display: none;
  }
  .mobile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.5rem 1rem 1.25rem;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .mobile[hidden] {
    display: none;
  }
  .mobile a:not(.btn) {
    padding: 0.8rem 0.25rem;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile .btn {
    margin-top: 1rem;
  }
  .acct {
    color: var(--ink-2);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.4rem 0.3rem;
  }
  .acct:hover {
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .links,
    .acct {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
    .menu-btn {
      display: inline-grid;
    }
  }
  @media (max-width: 420px) {
    .head-cta {
      display: none;
    }
  }
  .site-foot {
    margin-top: 6rem;
    padding: 4rem 0 2rem;
    border-top: 1px solid var(--line);
    background: var(--paper-2);
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
  }
  .foot-grid p {
    color: var(--ink-2);
    max-width: 24rem;
  }
  .small {
    font-size: 0.85rem;
  }
  .foot-grid nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .foot-grid h2 {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 0.5rem;
  }
  .foot-grid nav a {
    text-decoration: none;
    color: var(--ink);
    font-size: 0.95rem;
  }
  .foot-grid nav a:hover {
    color: var(--route);
  }
  .copy {
    margin-top: 3rem;
    color: var(--ink-2);
    font-size: 0.85rem;
  }
  @media (max-width: 760px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot-grid > div {
      grid-column: 1 / -1;
    }
  }
</style>
