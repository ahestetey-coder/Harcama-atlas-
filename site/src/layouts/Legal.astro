---
import Site from './Site.astro'
import { LEGAL_DRAFT, LEGAL_UPDATED, LEGAL_UPDATED_EN } from '../data/company'
import { counterpart, langOf, localize, translator } from '../lib/i18n'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '')
const lang = langOf(path)
const t = translator(lang)
const docs = [
  { href: '/yasal/kvkk', label: t('KVKK Aydınlatma Metni', 'KVKK Privacy Notice') },
  { href: '/yasal/acik-riza', label: t('Açık Rıza Metni', 'Explicit Consent') },
  { href: '/yasal/gizlilik', label: t('Gizlilik Politikası', 'Privacy Policy') },
  { href: '/yasal/cerez', label: t('Çerez Politikası', 'Cookie Policy') },
  { href: '/yasal/kullanim-kosullari', label: t('Kullanım Koşulları', 'Terms of Use') },
  { href: '/yasal/on-bilgilendirme', label: t('Ön Bilgilendirme Formu', 'Pre-Information Form') },
  { href: '/yasal/mesafeli-satis', label: t('Mesafeli Satış Sözleşmesi', 'Distance Sales Agreement') },
  { href: '/yasal/iptal-iade', label: t('İptal ve İade', 'Cancellation and Refunds') },
].map((d) => ({ ...d, href: localize(d.href, lang) }))
const original = counterpart(path).href
---

<Site title={`${title} · ${t('Harcama Atlası', 'Spending Atlas')}`} description={description}>
  <div class="wrap legal">
    <nav class="side" aria-label={t('Yasal metinler', 'Legal documents')}>
      <p class="eyebrow">{t('Yasal', 'Legal')}</p>
      {docs.map((d) => <a href={d.href} aria-current={path === d.href ? 'page' : undefined}>{d.label}</a>)}
    </nav>
    <article class="prose">
      <h1>{title}</h1>
      <p class="meta">{t('Son güncelleme', 'Last updated')}: {lang === 'en' ? LEGAL_UPDATED_EN : LEGAL_UPDATED}</p>
      {
        lang === 'en' && (
          <p class="draft" role="note">
            This English text is a courtesy translation. The <a href={original} lang="tr" hreflang="tr">Turkish original</a> is the legally binding version and prevails in
            case of any difference.
          </p>
        )
      }
      {
        LEGAL_DRAFT && (
          <p class="draft" role="note">
            Bu metin taslaktır ve hukuki incelemeden geçmemiştir. Sarı işaretli alanlar şirket bilgileri belli olunca doldurulacaktır.
          </p>
        )
      }
      <slot />
    </article>
  </div>
</Site>

<style>
  .legal {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 3rem;
    padding-top: 3rem;
  }
  .side {
    position: sticky;
    top: 5.5rem;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .side .eyebrow {
    margin: 0 0 0.75rem;
  }
  .side a {
    padding: 0.45rem 0.75rem;
    border-radius: 0.6rem;
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.93rem;
  }
  .side a:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
  .side a[aria-current='page'] {
    background: var(--brand-soft);
    color: var(--ink);
    font-weight: 600;
  }
  .meta {
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  .draft {
    padding: 0.85rem 1rem;
    border: 1px solid rgb(234 179 8 / 0.45);
    border-radius: 0.8rem;
    background: rgb(250 204 21 / 0.12);
    font-size: 0.93rem;
  }
  @media (max-width: 860px) {
    .legal {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 1.5rem;
    }
    .side {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .side .eyebrow {
      width: 100%;
      margin-bottom: 0.25rem;
    }
    .side a {
      border: 1px solid var(--line);
      font-size: 0.85rem;
      padding: 0.35rem 0.7rem;
    }
  }
</style>
