---
interface Props {
  title: string
  description: string
  lang?: 'tr' | 'en'
}
const { title, description, lang = 'tr' } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Tema: ?tema=koyu|acik > kayıtlı seçim > sistem
      try {
        const q = new URLSearchParams(location.search).get('tema')
        const saved = q === 'koyu' ? 'dark' : q === 'acik' ? 'light' : localStorage.getItem('ha-site-theme')
        if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 50;
    padding: 0.6rem 1rem;
    border-radius: 0.5rem;
    background: #000;
    color: #fff;
  }
  .skip:focus {
    top: 1rem;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    -webkit-font-smoothing: antialiased;
  }
  img,
  svg {
    display: block;
    max-width: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
