---
import { COMPANY } from '../data/company'
import { langOf } from '../lib/i18n'

interface Props {
  k: keyof typeof COMPANY
  /** Boşken görünecek açıklama */
  label: string
}
const { k, label } = Astro.props
const value = COMPANY[k]
const EN: Record<keyof typeof COMPANY, string> = {
  unvan: 'Company name',
  adres: 'Address',
  mersis: 'MERSIS no',
  vergiDairesi: 'Tax office',
  vergiNo: 'Tax no',
  kep: 'Registered email (KEP)',
  eposta: 'Email',
  telefon: 'Phone',
}
const en = langOf(Astro.url.pathname) === 'en'
---

{value ? <span>{value}</span> : <span class="fill" title={en ? 'Filled in once company details are set' : 'Şirket bilgisi girilince dolacak'}>[{en ? EN[k] : label}]</span>}

<style>
  .fill {
    padding: 0 0.3em;
    border-radius: 0.3em;
    background: rgb(250 204 21 / 0.28);
    color: var(--ink);
    font-weight: 600;
  }
</style>
